  "components": {
    "schemas": {
      "ApprovalRequest": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "decision_fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Decision Fingerprint"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "decision_fingerprint"
        ],
        "title": "ApprovalRequest"
      },
      "Execution": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 80,
            "minLength": 16,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Idempotency Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "idempotency_key"
        ],
        "title": "Execution"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Mutation": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "destination": {
            "type": "string",
            "pattern": "^bank:[0-9]{4}$",
            "title": "Destination"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "destination"
        ],
        "title": "Mutation"
      },
      "Reason": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 8,
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "reason"
        ],
        "title": "Reason"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Verification": {
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Version"
          },
          "destination": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Destination"
          },
          "contact_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Contact Id"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 12,
            "title": "Note"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "version",
          "destination",
          "contact_id",
          "note"
        ],
        "title": "Verification"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}