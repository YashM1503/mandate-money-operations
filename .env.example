# Environment variables are not automatically loaded. Use your platform's secret manager.
# Local authentication is generated by scripts/bootstrap.py; NEVER commit config.json.
MANDATE_DATA_DIR=./data
MANDATE_ALLOWED_HOSTS=localhost,127.0.0.1
# Cloud hosts are also picked up from RENDER_EXTERNAL_HOSTNAME, RAILWAY_PUBLIC_DOMAIN,
# WEBSITE_HOSTNAME, and FLY_APP_NAME. Set * only for a private demo allow-all.
PORT=8000
# Synthetic outbound model calls and PRISM logging require explicit opt-in.
MANDATE_ALLOW_SYNTHETIC_EGRESS=0
MANDATE_MODEL_URL=
MANDATE_MODEL_KEY=
MANDATE_MODEL_NAME=
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
MANDATE_PRISM_TRANSPORT=sdk
# Bounded ingest, analysis, and local storage controls.
MANDATE_MAX_UPLOAD_BYTES=2000000
MANDATE_MAX_UPLOAD_ROWS=50000
MANDATE_MAX_DATASETS_PER_USER=50
MANDATE_MAX_ANALYSES_PER_DATASET=200
# Money Operations optional voice briefing. Off unless explicitly enabled.
# Voice cannot approve, edit, submit, or distribute. Approved text is authoritative.
MONEY_OPS_AUDIO_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
MONEY_OPS_AUDIO_CACHE_ENTRIES=32
# Optional cloud secret-manager override; see docs/DEPLOYMENT.md.
# MANDATE_SIGNING_KEY=<64+ character random secret>
# MANDATE_USERS_JSON=<PBKDF2 user map produced by bootstrap; NOT plaintext passwords>
