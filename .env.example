# Environment variables are not automatically loaded. Use your platform's secret manager.
# Local authentication is generated by scripts/bootstrap.py; NEVER commit config.json.
MANDATE_DATA_DIR=./data
MANDATE_ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8000
# Synthetic outbound model calls and PRISM logging require explicit opt-in.
MANDATE_ALLOW_SYNTHETIC_EGRESS=0
MANDATE_MODEL_URL=
MANDATE_MODEL_KEY=
MANDATE_MODEL_NAME=
PRISMTRACE_HOST=https://prism.blockconvey.com
PRISMTRACE_API_KEY=
PRISMTRACE_PROJECT_ID=
MANDATE_PRISM_TRANSPORT=sdk
# Optional cloud secret-manager override; see docs/DEPLOYMENT.md.
# MANDATE_SIGNING_KEY=<64+ character random secret>
# MANDATE_USERS_JSON=<PBKDF2 user map produced by bootstrap; NOT plaintext passwords>
